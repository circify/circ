// A single product, asserted directly against a public matrix. The witnessed
// product is then equal to a public input, so R1CS linearity reduction empties
// the prover's first round -- the case that must not claim an aux block.
// TEST_FILE
// FEATURES: r1cs poly zok
// CMD: $circ $file r1cs --proof-impl mirage --action count
// CMD: $circ --ir-matmul-ip false $file r1cs --proof-impl mirage --action count
def main(public field[3][3] A, public field[3][3] B, public field[3][3] P) -> bool:
    assert(P == (A * B))
    return true
